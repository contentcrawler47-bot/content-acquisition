{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/contentcrawler47-bot/content-acquisition/schema/bian-extract.schema.json",
 "title": "BIAN landscape extract (stage 1)",
 "description": "The contract between stage 1 (extract) and stage 2 (render). The extract is several files: an index whose type is Extract, and one part file per bulk collection whose type is ExtractPart. Both are validated by this schema, which branches on that type. Structural only: referential integrity across the graph is checked by tools/check_extract.py, which reports counts against denominators rather than a conformance boolean. Note $id here is JSON Schema's identifier and is unrelated to JSON-LD's @id, which appears in the instance as the term 'id'.",
 "type": "object",
 "required": [
  "@context",
  "id",
  "type"
 ],
 "properties": {
  "type": {
   "enum": [
    "Extract",
    "ExtractPart"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "type": {
      "const": "Extract"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "required": [
     "@context",
     "id",
     "type",
     "extract",
     "status",
     "notations",
     "categories",
     "models",
     "parts",
     "content_digest"
    ],
    "additionalProperties": false,
    "properties": {
     "@context": {
      "$ref": "#/$defs/context"
     },
     "id": {
      "type": "string",
      "pattern": "^urn:bian:"
     },
     "type": {
      "const": "Extract"
     },
     "content_digest": {
      "$ref": "#/$defs/sha256"
     },
     "extract": {
      "type": "object",
      "required": [
       "source_id",
       "base_url",
       "fetched_at",
       "schema_version",
       "parser_version",
       "mode",
       "shards"
      ],
      "additionalProperties": false,
      "properties": {
       "source_id": {
        "type": "string",
        "minLength": 1
       },
       "base_url": {
        "type": "string",
        "minLength": 1
       },
       "fetched_at": {
        "type": "string",
        "minLength": 10
       },
       "schema_version": {
        "type": "string",
        "minLength": 1
       },
       "parser_version": {
        "type": "string",
        "minLength": 1
       },
       "mode": {
        "enum": [
         "model-only",
         "full"
        ]
       },
       "shards": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       },
       "run": {
        "type": "object",
        "description": "Which CI run produced this extract. Optional: extracts written before schema 1.5.0 carry no run block, and stage 2 must still read them. Excluded from content_digest by construction, so two runs over identical content agree.",
        "required": [
         "where"
        ],
        "additionalProperties": false,
        "properties": {
         "where": {
          "enum": [
           "github-actions",
           "local"
          ]
         },
         "run_id": {
          "type": "string"
         },
         "run_attempt": {
          "type": "string"
         },
         "run_number": {
          "type": "string"
         },
         "workflow": {
          "type": "string"
         },
         "repository": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        }
       }
      }
     },
     "status": {
      "type": "object",
      "required": [
       "gate",
       "geometry",
       "geometry_unboxed",
       "malformed_objects",
       "models",
       "models_tried",
       "models_url",
       "notation_unresolved",
       "objects_with_properties",
       "property_groups_skipped",
       "unresolved_members",
       "views_with_geometry",
       "views_with_model"
      ],
      "additionalProperties": true,
      "properties": {
       "models": {
        "enum": [
         "present",
         "not-fetched"
        ]
       },
       "geometry": {
        "enum": [
         "present",
         "not-fetched"
        ]
       },
       "notation_unresolved": {
        "type": "integer",
        "minimum": 0
       },
       "malformed_objects": {
        "type": "integer",
        "minimum": 0
       },
       "malformed_object_ids": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "unresolved_members": {
        "type": "integer",
        "minimum": 0
       },
       "models_url": {
        "type": "string",
        "description": "The candidate path that answered, or empty when none did."
       },
       "models_tried": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "Every candidate attempted, in order, so a failure names what was tried."
       },
       "views_with_model": {
        "type": "integer",
        "minimum": 0
       },
       "views_with_geometry": {
        "type": "integer",
        "minimum": 0
       },
       "geometry_unboxed": {
        "type": "integer",
        "minimum": 0
       },
       "objects_with_properties": {
        "type": "integer",
        "minimum": 0
       },
       "property_groups_skipped": {
        "type": "integer",
        "minimum": 0
       },
       "geometry_endless_edges": {
        "type": "integer",
        "minimum": 0
       },
       "geometry_unboxed_concepts": {
        "type": "object",
        "additionalProperties": {
         "type": "integer",
         "minimum": 0
        }
       },
       "geometry_endless_edge_concepts": {
        "type": "object",
        "additionalProperties": {
         "type": "integer",
         "minimum": 0
        }
       },
       "gate": {
        "$ref": "#/$defs/gate"
       }
      },
      "description": "Observations about the RUN, not about what BIAN published. Excluded from content_digest by construction, so two runs over identical content agree even when their gate findings differ. additionalProperties stays true so a new counter can land without a schema bump -- but every key emitted must still be DECLARED here, and gate finding G70 fails when one is not. Six counters validated for months while being unknown to this contract, which meant any of them could have stopped being emitted without failing anything."
     },
     "notations": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/notation"
      }
     },
     "categories": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/category"
      }
     },
     "models": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/model"
      }
     },
     "parts": {
      "type": "array",
      "minItems": 6,
      "description": "One entry per collection, each listing its range partitions with the boundaries that define the partition function. Boundaries are cut at equal rank and published here, so placement is a lookup against this document rather than a computation a reader must reimplement.",
      "items": {
       "type": "object",
       "required": [
        "part",
        "count",
        "content_digest",
        "partitions"
       ],
       "additionalProperties": false,
       "properties": {
        "part": {
         "enum": [
          "objects",
          "relations",
          "views",
          "view_members",
          "geometry_nodes",
          "geometry_edges"
         ]
        },
        "count": {
         "type": "integer",
         "minimum": 0
        },
        "content_digest": {
         "$ref": "#/$defs/sha256"
        },
        "partitions": {
         "type": "array",
         "minItems": 1,
         "items": {
          "$ref": "#/$defs/partition"
         }
        }
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "type": {
      "const": "ExtractPart"
     }
    },
    "required": [
     "type"
    ]
   },
   "then": {
    "required": [
     "@context",
     "content_digest",
     "count",
     "extract",
     "id",
     "max_key",
     "min_key",
     "part",
     "partition",
     "type"
    ],
    "additionalProperties": false,
    "properties": {
     "@context": {
      "$ref": "#/$defs/context"
     },
     "id": {
      "type": "string",
      "pattern": "^urn:bian:"
     },
     "type": {
      "const": "ExtractPart"
     },
     "part": {
      "enum": [
       "objects",
       "relations",
       "views",
       "view_members",
       "geometry_nodes",
       "geometry_edges"
      ]
     },
     "extract": {
      "type": "string",
      "pattern": "^urn:bian:"
     },
     "count": {
      "type": "integer",
      "minimum": 0
     },
     "content_digest": {
      "$ref": "#/$defs/sha256"
     },
     "objects": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/object"
      }
     },
     "relations": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/relation"
      }
     },
     "views": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/view"
      }
     },
     "view_members": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/viewMember"
      }
     },
     "partition": {
      "type": "integer",
      "minimum": 0
     },
     "min_key": {
      "type": "integer"
     },
     "max_key": {
      "type": "integer"
     },
     "geometry_nodes": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/geometryNode"
      }
     },
     "geometry_edges": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/geometryEdge"
      }
     }
    }
   }
  }
 ],
 "$defs": {
  "category": {
   "type": "object",
   "required": [
    "type",
    "name",
    "object_count"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "Category"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "object_count": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "context": {
   "type": "object",
   "description": "Embedded JSON-LD context. Embedded rather than referenced by URL so every file is self-describing offline, and generated from one symbol so the copies cannot drift.",
   "minProperties": 1
  },
  "gate": {
   "type": "object",
   "description": "The source input gate: what BIAN publishes that the parser does not consume. Carried in the extract rather than left in the run log, so sub-threshold findings travel with the artifact and diff between runs. `ok` null with detail 'not run' means the gate did not run at all, which is not a pass.",
   "additionalProperties": true,
   "properties": {
    "gate_version": {
     "type": [
      "string",
      "null"
     ]
    },
    "ok": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "detail": {
     "type": "string"
    },
    "observe_only": {
     "type": "boolean"
    },
    "aggregate_breached": {
     "type": "boolean"
    },
    "under_threshold_total_share": {
     "type": "number",
     "minimum": 0
    },
    "thresholds": {
     "type": "object",
     "additionalProperties": true
    },
    "failed": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gateFinding"
     }
    },
    "under_threshold": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gateFinding"
     }
    },
    "registered": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gateFinding"
     }
    },
    "not_measured": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gateFinding"
     }
    },
    "inventory": {
     "type": "object",
     "additionalProperties": true
    },
    "exclusions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "code",
       "what",
       "where",
       "why",
       "bound"
      ],
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "what": {
        "type": "string"
       },
       "where": {
        "type": "string"
       },
       "why": {
        "type": "string"
       },
       "bound": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       }
      }
     }
    }
   }
  },
  "gateFinding": {
   "type": "object",
   "description": "One gate finding, always with its denominator. `affected` null means NOT MEASURED -- the observation could not be made, which is never the same as zero.",
   "required": [
    "affected",
    "bound",
    "class",
    "code",
    "denominator",
    "sampled",
    "what"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "type": "string",
     "minLength": 1
    },
    "what": {
     "type": "string",
     "minLength": 1
    },
    "affected": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "denominator": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "class": {
     "enum": [
      "fail-always",
      "thresholded",
      "registered"
     ]
    },
    "detail": {
     "type": "string"
    },
    "share": {
     "type": "number",
     "minimum": 0
    },
    "sampled": {
     "type": "boolean",
     "description": "True when the denominator is a sample rather than the population. Such a finding may fail on its own but is excluded from the at-risk aggregate: a share over 12 sampled views and a share over 128,270 objects cannot be added together."
    },
    "bound": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "description": "The largest affected count that is still the decision rather than a change in the source. A REGISTERED finding above its bound FAILS: registering something is a decision about a quantity, so the quantity binds. Null means unbounded, which is correct only for a sample-dependent count, where an absolute bound would fail on a change of sample size rather than of content."
    }
   }
  },
  "geometryEdge": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "view",
    "edge_id",
    "object",
    "concept",
    "label",
    "from_node",
    "to_node"
   ],
   "properties": {
    "type": {
     "const": "GeometryEdge"
    },
    "view": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:view:"
    },
    "edge_id": {
     "type": "string",
     "minLength": 1
    },
    "object": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^urn:bian:[^:]+:object:"
    },
    "concept": {
     "type": "string",
     "minLength": 1
    },
    "label": {
     "type": "string"
    },
    "from_node": {
     "type": [
      "string",
      "null"
     ]
    },
    "to_node": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "geometryNode": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "view",
    "node_id",
    "object",
    "concept",
    "label",
    "x",
    "y",
    "w",
    "h",
    "parent_id"
   ],
   "description": "A drawn box. `concept` is the SHAPE the page used, not the type: 339 service domains on view 54486 are drawn as StrategyCapability. The type comes from the model, through `object`.",
   "properties": {
    "type": {
     "const": "GeometryNode"
    },
    "view": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:view:"
    },
    "node_id": {
     "type": "string",
     "minLength": 1
    },
    "object": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^urn:bian:[^:]+:object:"
    },
    "concept": {
     "type": "string",
     "minLength": 1
    },
    "label": {
     "type": "string"
    },
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    },
    "w": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "h": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "parent_id": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "model": {
   "type": "object",
   "required": [
    "type",
    "name",
    "view_count"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "Model"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "view_count": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "notation": {
   "type": "object",
   "required": [
    "type",
    "name",
    "object_count"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "const": "Notation"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "object_count": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "object": {
   "type": "object",
   "required": [
    "id",
    "type",
    "object_id",
    "name",
    "category",
    "notation"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:object:"
    },
    "type": {
     "const": "Object"
    },
    "object_id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string"
    },
    "category": {
     "type": "string",
     "minLength": 1
    },
    "notation": {
     "type": [
      "string",
      "null"
     ]
    },
    "type_icon_path": {
     "type": "string"
    },
    "documentation": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "properties": {
     "description": "Raw property table off the source object: group name -> field name -> value. Stored unflattened because the shapes carry meaning -- a `structure` is a record of named fields, and `/ 6. SO parameters` holds 45,263 of them giving the full parameter signature of every BIAN service operation, which flattening to text destroys. Unfiltered, because the extract is the unfiltered stage 1 record and select.py is the only place the allowlist acts. Groups whose value is not a mapping are skipped by the extractor and counted in status.property_groups_skipped rather than dropped silently. Optional: extracts written before schema 1.6.0 carry no properties, and stage 2 must still read them.",
     "type": "object",
     "additionalProperties": {
      "type": "object"
     }
    }
   }
  },
  "partition": {
   "type": "object",
   "required": [
    "file",
    "partition",
    "min_key",
    "max_key",
    "count",
    "content_digest",
    "bytes"
   ],
   "additionalProperties": false,
   "properties": {
    "file": {
     "type": "string",
     "pattern": "-[0-9]{4}\\.jsonld$"
    },
    "partition": {
     "type": "integer",
     "minimum": 0
    },
    "min_key": {
     "type": "integer"
    },
    "max_key": {
     "type": "integer"
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "content_digest": {
     "$ref": "#/$defs/sha256"
    },
    "bytes": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "relation": {
   "type": "object",
   "required": [
    "id",
    "type",
    "source",
    "target",
    "verb"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:relation:"
    },
    "type": {
     "const": "Relation"
    },
    "source": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:object:"
    },
    "target": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:object:"
    },
    "verb": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "view": {
   "type": "object",
   "required": [
    "id",
    "type",
    "view_id",
    "title",
    "diagram_object",
    "kind",
    "model",
    "member_count",
    "has_geometry"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:view:"
    },
    "type": {
     "const": "View"
    },
    "view_id": {
     "type": "string",
     "minLength": 1
    },
    "title": {
     "type": "string"
    },
    "diagram_object": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^urn:bian:[^:]+:object:"
    },
    "diagram_category": {
     "type": [
      "string",
      "null"
     ]
    },
    "kind": {
     "enum": [
      "sequence",
      "class",
      "other",
      "unnamed"
     ]
    },
    "model": {
     "type": [
      "string",
      "null"
     ]
    },
    "member_count": {
     "type": "integer",
     "minimum": 0
    },
    "has_geometry": {
     "type": "boolean"
    }
   }
  },
  "viewMember": {
   "type": "object",
   "required": [
    "type",
    "view",
    "target",
    "target_type"
   ],
   "additionalProperties": false,
   "description": "A placement on a view. The target is usually an object, but objectsOnViews also carries diagram-to-diagram references, so target_type says which.",
   "properties": {
    "type": {
     "const": "ViewMember"
    },
    "view": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:view:"
    },
    "target": {
     "type": "string",
     "pattern": "^urn:bian:[^:]+:(object|view):"
    },
    "target_type": {
     "enum": [
      "object",
      "view",
      "unresolved"
     ]
    }
   }
  }
 }
}
